rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin function - check if user is admin
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == 'chethankrishna2022@gmail.com' ||
              request.auth.token.email == 'rupakbabu1994@gmail.com');
    }
    
    // App configuration - allow anyone to read version info for updates
    match /app_config/{document} {
      allow read: if true;  // Anyone can read app config (for update checking)
      allow write: if isAdmin(); // Only admin can write
    }
    
    // Users collection - allow authenticated users + admin full access
    match /users/{userId} {
      // Admin has full access to all user data
      allow read, write: if isAdmin();
      
      // Users can read/write their own data when authenticated
      allow read, write: if isSelf(userId);
    }

    // Usage analytics - allow clients to record their own usage
    match /usage_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /credit_usage_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /user_usage_stats/{userId} {
      allow read: if isAdmin();
      allow write: if isSelf(userId) || isAdmin();
    }

    match /analytics_global/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
    
    // Notifications collection - admin can read/write, users can read
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn();
    }
    
    // Payments collection - authenticated users can create/read their own records
    match /payments/{paymentId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    // Admin panel collections - only admin access
    match /admin/{document} {
      allow read, write: if isAdmin();
    }
    
    // Test collection for debugging
    match /_test/{document} {
      allow read, write: if isAdmin();
    }
  }
}
