rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins, by verified email: an unverified email/password account using an admin's address isn't one.
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             (request.auth.token.email == 'chethankrishna2022@gmail.com' ||
              request.auth.token.email == 'rupakbabu1994@gmail.com');
    }

    // Whether an admin has banned the signed-in account (one read; only used on rare writes).
    function isBanned() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }

    // Fields only an admin sets on a profile: the ban and admin-granted Pro.
    function touchesAdminFields(before, after) {
      return after.diff(before).affectedKeys().hasAny(['banned', 'bannedReason', 'bannedAt', 'proGrantedAt']);
    }

    // Free accounts may hold at most this many credits unless an admin grants more.
    function maxSelfCredits() {
      return 20;
    }

    // A client may only turn Pro on together with a Google Play purchase token
    // (set by the in-app purchase flow). Admin-granted Pro keeps working because
    // this only applies when isPro changes from false to true.
    function proChangeAllowed(before, after) {
      return after.get('isPro', false) != true
        || before.get('isPro', false) == true
        || (after.get('subscription', {}).get('purchaseToken', '') is string
            && after.get('subscription', {}).get('purchaseToken', '').size() > 20);
    }

    // The built-in AI allowance: a client may only spend credits, never add them back (not even up to the
    // starting amount). Only admins can raise them. New profiles start at no more than maxSelfCredits().
    function creditsChangeAllowed(before, after) {
      return !('credits' in after)
        || after.credits == before.get('credits', 0)
        || (after.credits is int && after.credits >= 0 && after.credits < before.get('credits', 0));
    }

    // App configuration - allow anyone to read version info for updates
    match /app_config/{document} {
      allow read: if true;  // Anyone can read app config (for update checking)
      allow write: if isAdmin(); // Only admin can write
    }

    // Users collection
    match /users/{userId} {
      // Admin has full access to all user data
      allow read, write: if isAdmin();

      // Users can read their own data
      allow read: if isSelf(userId);

      // New accounts start as free users with at most the free credits.
      allow create: if isSelf(userId)
        && request.resource.data.get('isPro', false) == false
        && request.resource.data.get('credits', 0) <= maxSelfCredits()
        && !request.resource.data.keys().hasAny(['banned', 'bannedReason', 'bannedAt', 'proGrantedAt']);

      // Users can update their own data, but can't self-grant Pro or credits, can't touch the ban,
      // and a banned account can't change its profile at all.
      allow update: if isSelf(userId)
        && resource.data.get('banned', false) != true
        && !touchesAdminFields(resource.data, request.resource.data)
        && proChangeAllowed(resource.data, request.resource.data)
        && creditsChangeAllowed(resource.data, request.resource.data);

      allow delete: if isSelf(userId);

      // Messages the admin sends to just this person: only they (and admins) can read them.
      match /inbox/{messageId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Device installs (signed in or not) for the admin dashboard.
    // Write-only for clients and restricted to exactly these fields.
    function validInstall(data) {
      return data.keys().hasOnly(['platform', 'appVersion', 'buildNumber', 'lastSeenAt', 'firstSeenAt', 'uid'])
        && data.platform in ['android', 'ios', 'web', 'other']
        && data.appVersion is string && data.appVersion.size() <= 32
        && data.buildNumber is string && data.buildNumber.size() <= 16
        && data.lastSeenAt == request.time
        && (!('firstSeenAt' in data) || data.firstSeenAt is timestamp);
    }

    match /app_installs/{installId} {
      allow read, delete: if isAdmin();
      allow create: if installId.matches('^[a-z0-9]{16,64}$')
        && validInstall(request.resource.data)
        && (!('uid' in request.resource.data)
            || (isSignedIn() && request.resource.data.uid == request.auth.uid));
      allow update: if validInstall(request.resource.data)
        && (!('uid' in request.resource.data)
            || (isSignedIn() && request.resource.data.uid == request.auth.uid)
            || request.resource.data.uid == resource.data.get('uid', ''));
    }

    // Usage analytics - allow clients to record their own usage
    match /usage_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /credit_usage_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /user_usage_stats/{userId} {
      allow read: if isAdmin();
      allow write: if isSelf(userId) || isAdmin();
    }

    match /analytics_global/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    // Notifications collection - admin can read/write, users can read
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn();
    }

    // Old payment records from before Google Play billing. Purchases are Play-only now; nobody but an
    // admin reads or writes these.
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // In-app announcements, campaigns and release notes published from the admin panel: public, so they
    // reach people who never signed in. Only admins write them.
    match /in_app_messages/{messageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community keyboard themes: anyone can browse and download them; publishing needs a session (signed in
    // or the app's silent per-install one). Only the theme's own fields can be written, within size limits.
    function validThemeContent(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.spec is string && data.spec.size() >= 2 && data.spec.size() <= 4000
        && data.night is bool
        && data.style is string && data.style.size() <= 20;
    }

    match /keyboard_themes/{themeId} {
      // Browsing needs no account: themes are public content. Pages stay small.
      allow get: if true;
      allow list: if isAdmin() || request.query.limit <= 50;

      allow create: if isSignedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly(['name', 'spec', 'night', 'style', 'authorName', 'authorUid', 'createdAt', 'downloads'])
        && request.resource.data.keys().hasAll(['name', 'spec', 'night', 'style', 'authorName', 'authorUid', 'createdAt', 'downloads'])
        && validThemeContent(request.resource.data)
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.downloads == 0;

      // The author may edit the theme itself; anyone signed in may count one download.
      allow update: if isSignedIn() && (
        (resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'spec', 'night', 'style'])
          && validThemeContent(request.resource.data))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
          && request.resource.data.downloads == resource.data.downloads + 1)
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Admin panel collections - only admin access
    match /admin/{document} {
      allow read, write: if isAdmin();
    }

    // What the in-app admin panel changed, by whom. Append-only.
    match /admin_audit/{entryId} {
      allow read, create: if isAdmin();
    }

    // Test collection for debugging
    match /_test/{document} {
      allow read, write: if isAdmin();
    }
  }
}
