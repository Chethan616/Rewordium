<!--
  Rewordium AI panel mark — the "open the AI tools panel" quick-action.

  Visual: rounded-rectangle frame holding two filled sparkles. Frame stays
  outlined to read as "container / open this surface"; sparkles are filled
  so they match ic_quick_ai_rewrite's optical weight at 24dp. Pairs as a
  family with the rewrite mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Panel frame (outline kept so the rectangle reads as a container) -->
    <path
        android:strokeColor="#000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4.5,3.5 L19.5,3.5 A1.5,1.5 0 0 1 21,5 L21,19 A1.5,1.5 0 0 1 19.5,20.5 L4.5,20.5 A1.5,1.5 0 0 1 3,19 L3,5 A1.5,1.5 0 0 1 4.5,3.5 Z" />
    <!-- Mini sparkles inside (filled to match the rewrite mark) -->
    <path
        android:fillColor="#000"
        android:pathData="M11,7 L11.75,9.25 L14,10 L11.75,10.75 L11,13 L10.25,10.75 L8,10 L10.25,9.25 Z" />
    <path
        android:fillColor="#000"
        android:pathData="M15,12.5 L15.5,14 L17,14.5 L15.5,15 L15,16.5 L14.5,15 L13,14.5 L14.5,14 Z" />
</vector>
