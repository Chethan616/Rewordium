# Android SDK path (set by Android Studio on most machines)
sdk.dir=/path/to/your/Android/sdk

# Local release version. The app uses these values when present.
projectVersionName=3.1.0
projectVersionCode=124

# Optional build-time API keys. Do not commit real values.
GROQ_API_KEY=your_groq_api_key_here
KLIPY_API_KEY=your_klipy_api_key_here
