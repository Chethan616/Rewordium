    <!-- Jade pops onto the shape. -->
    <target android:name="jade">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="460"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="240"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="460"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="240"
                    android:valueFrom="0"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>

    <!-- …and blinks hello. -->
    <target android:name="eyes">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="70"
                    android:interpolator="@android:interpolator/fast_out_linear_in"
                    android:propertyName="scaleY"
                    android:startOffset="780"
                    android:valueFrom="1"
                    android:valueTo="0.1" />
                <objectAnimator
                    android:duration="110"
                    android:interpolator="@android:interpolator/linear_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.1"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
