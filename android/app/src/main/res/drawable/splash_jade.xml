                android:valueFrom="M231.53,115.80 C236.43,130.85 237.30,146.86 234.15,162.26 C233.47,165.61 232.60,168.93 231.53,172.20 C230.47,175.47 229.23,178.67 227.81,181.78 C222.72,192.97 215.42,203.03 206.35,211.33 C203.83,213.63 201.17,215.80 198.38,217.83 C195.60,219.85 192.71,221.71 189.74,223.39 C179.04,229.45 167.23,233.29 155.01,234.68 C151.61,235.06 148.19,235.26 144.74,235.26 C141.30,235.26 137.88,235.06 134.48,234.68 C122.26,233.29 110.45,229.45 99.75,223.39 C96.78,221.71 93.89,219.85 91.11,217.83 C88.32,215.80 85.66,213.63 83.14,211.33 C74.07,203.03 66.77,192.97 61.68,181.78 C60.26,178.67 59.02,175.47 57.96,172.20 C56.89,168.93 56.02,165.61 55.33,162.26 C52.87,150.21 52.87,137.79 55.33,125.74 C56.02,122.39 56.89,119.07 57.96,115.80 C59.02,112.53 60.26,109.33 61.68,106.22 C66.77,95.03 74.07,84.97 83.14,76.67 C85.66,74.37 88.32,72.20 91.11,70.17 C93.89,68.15 96.78,66.29 99.75,64.61 C110.45,58.55 122.26,54.71 134.48,53.32 C137.88,52.94 141.30,52.74 144.74,52.74 C148.19,52.74 151.61,52.94 155.01,53.32 C170.62,55.09 185.58,60.87 198.38,70.17 C200.57,71.76 202.69,73.45 204.71,75.22 C215.09,84.27 223.29,95.55 228.69,108.22 C229.75,110.70 230.70,113.22 231.53,115.80 Z"
                android:valueTo="M225.29,114.59 C233.68,123.71 235.15,137.54 228.35,148.34 C226.40,151.43 225.10,154.84 224.47,158.37 C223.85,161.90 223.91,165.55 224.68,169.12 C227.72,183.15 219.61,197.20 205.94,201.58 C202.46,202.70 199.27,204.47 196.53,206.78 C193.78,209.08 191.48,211.91 189.78,215.14 C183.08,227.85 167.84,233.40 154.55,227.97 C151.17,226.59 147.58,225.90 144.00,225.90 C140.42,225.90 136.83,226.59 133.45,227.97 C120.16,233.40 104.92,227.85 98.22,215.14 C96.52,211.91 94.22,209.08 91.47,206.78 C88.73,204.47 85.54,202.70 82.06,201.58 C68.39,197.20 60.28,183.15 63.32,169.12 C64.09,165.55 64.15,161.90 63.53,158.37 C62.90,154.84 61.60,151.43 59.65,148.34 C52.00,136.19 54.82,120.22 66.16,111.42 C69.05,109.19 71.44,106.43 73.23,103.32 C75.02,100.22 76.22,96.77 76.71,93.15 C78.66,78.93 91.08,68.50 105.43,69.06 C109.08,69.20 112.68,68.62 116.05,67.39 C119.42,66.17 122.55,64.29 125.26,61.84 C135.89,52.19 152.11,52.19 162.74,61.84 C165.45,64.29 168.58,66.17 171.95,67.39 C175.32,68.62 178.92,69.20 182.57,69.06 C195.33,68.56 206.57,76.75 210.27,88.58 C210.73,90.05 211.07,91.58 211.29,93.15 C212.28,100.39 216.06,106.95 221.84,111.42 C223.09,112.40 224.24,113.46 225.29,114.59 Z"
