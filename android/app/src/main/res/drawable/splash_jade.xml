                        android:pathData="M47.25,61.89Q50,64.98 52.76,61.89"
                        android:strokeWidth="1.76"
                        android:strokeColor="#15161A"
                        android:strokeLineCap="round" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- The shape turns in and swells past full size, then settles. -->
    <target android:name="shape">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="760"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="rotation"
                    android:valueFrom="-120"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="640"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="640"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>

