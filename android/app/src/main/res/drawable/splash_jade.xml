                    <group
                        android:name="eyes"
                        android:pivotX="50"
                        android:pivotY="55">
                        <path
                            android:fillColor="#15161A"
                            android:pathData="M39.64,55A3.47,4.74 0,1 1,46.58 55A3.47,4.74 0,1 1,39.64 55ZM53.42,55A3.47,4.74 0,1 1,60.36 55A3.47,4.74 0,1 1,53.42 55Z" />
                        <path
                            android:fillColor="#FFFFFF"
                            android:pathData="M40.82,53.29A1.25,1.25 0,1 1,43.32 53.29A1.25,1.25 0,1 1,40.82 53.29ZM54.6,53.29A1.25,1.25 0,1 1,57.1 53.29A1.25,1.25 0,1 1,54.6 53.29ZM43.63,56.71A0.59,0.59 0,1 1,44.81 56.71A0.59,0.59 0,1 1,43.63 56.71ZM57.41,56.71A0.59,0.59 0,1 1,58.59 56.71A0.59,0.59 0,1 1,57.41 56.71Z" />
