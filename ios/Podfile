# Uncomment this line to define a global platform for your project
platform :ios, '17.0'

$iOSVersion = '17.0' # MLKit requires 15.5+; 17.0 matches our deployment target

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  # Match the standard Flutter Podfile template: use __FILE__ (path to this
  # Podfile) as the expand base, NOT __dir__. With __dir__ ("ios/"), the `..`
  # resolves to <root>/Flutter/Generated.xcconfig — which doesn't exist. With
  # __FILE__ ("ios/Podfile"), File.expand_path treats the trailing path
  # component as if it were a dir, so .. correctly walks back to ios/, giving
  # <root>/ios/Flutter/Generated.xcconfig. This subtle quirk is why every
  # Flutter Podfile in the wild uses __FILE__.
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # MLKit language packs for multi-script text recognition
  # Version must match GoogleMLKit/TextRecognition ~> 9.0.0 required by
  # google_mlkit_text_recognition 0.15.1 — do NOT change to a different major.
  pod 'GoogleMLKit/TextRecognitionChinese', '~> 9.0.0'
  pod 'GoogleMLKit/TextRecognitionDevanagari', '~> 9.0.0'
  pod 'GoogleMLKit/TextRecognitionJapanese', '~> 9.0.0'
  pod 'GoogleMLKit/TextRecognitionKorean', '~> 9.0.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# The RewordiumKeyboard app extension target is intentionally NOT listed here.
# Flutter plugins are not extension-safe (Firebase / file_picker / etc. expect
# the host UIApplication). The extension links KeyboardKit via SwiftPM only.

post_install do |installer|
  # Required for MLKit: exclude armv7 on all build configs
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=*]'] = 'armv7'
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Enforce minimum iOS version required by MLKit on all pods
    target.build_configurations.each do |config|
      if Gem::Version.new($iOSVersion) > Gem::Version.new(config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || '0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
      end

      # MLKit family doesn't ship arm64-simulator slices, but we need
      # arm64 sim for iOS 26 / Liquid Glass testing. Resolution: skip
      # MLKit pods entirely on simulator (both arches) by excluding both
      # 'arm64' and 'x86_64' for iphonesimulator → the pod compiles for
      # zero sim arches → the resulting framework is empty for sim.
      #
      # GeneratedPluginRegistrant.m's reference to the MLKit Flutter
      # plugin is then wrapped in `#if !TARGET_OS_SIMULATOR` by a
      # codemagic.yaml post-pub-get script step, so the app's link step
      # doesn't pull in MLKit symbols on sim.
      #
      # Device builds (arm64-iphoneos) are unaffected: MLKit ships those
      # slices, the registration code compiles normally, OCR works.
      # On sim there's no camera anyway — OCR being unavailable is the
      # right behavior.
      mlkit_target = target.name.start_with?('GoogleMLKit', 'MLImage',
                                              'MLKitCommon', 'MLKitVision',
                                              'google_mlkit_')
      if mlkit_target
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64 x86_64'
      end
    end
  end

  # ─── Patch GeneratedPluginRegistrant.m to skip MLKit on simulator ────
  #
  # We have to do this here (in pod post_install) rather than as a
  # standalone codemagic.yaml step, because `flutter build ios` runs
  # `injectPlugins` internally which REGENERATES the registrant from
  # scratch every build — any pre-build patch gets overwritten before
  # xcodebuild runs. pod install (which fires this hook) runs AFTER
  # injectPlugins and BEFORE xcodebuild, so the patch sticks.
  #
  # The patch wraps every MLKit-related @import + +registerWithRegistrar:
  # line in `#if !TARGET_OS_SIMULATOR` so the sim build doesn't try to
  # link against MLKit symbols that don't exist (the MLKit pods are
  # excluded from sim arches by the loop above). Device builds are
  # untouched — MLKit ships arm64-iphoneos slices and OCR works there.
  #
  # Idempotent: we detect already-wrapped lines (preceding `#if
  # !TARGET_OS_SIMULATOR`) and don't double-wrap.
  registrant_path = File.expand_path('Runner/GeneratedPluginRegistrant.m', __dir__)
  if File.exist?(registrant_path)
    lines = File.readlines(registrant_path)
    out = []
    lines.each_with_index do |line, i|
      mlkit_line = line.include?('google_mlkit') || line.include?('GoogleMlkit')
      prev_already_guarded = i > 0 && lines[i - 1].include?('#if !TARGET_OS_SIMULATOR')
      if mlkit_line && !prev_already_guarded
        out << "#if !TARGET_OS_SIMULATOR\n"
        out << line
        out << "#endif\n"
      else
        out << line
      end
    end
    File.write(registrant_path, out.join)
    puts "[Podfile] Wrapped MLKit registrations in #if !TARGET_OS_SIMULATOR"
  else
    puts "[Podfile] GeneratedPluginRegistrant.m not found (skipped patch)"
  end
end
