# Uncomment this line to define a global platform for your project
platform :ios, '17.0'

$iOSVersion = '17.0' # MLKit requires 15.5+; 17.0 matches our deployment target

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  # Match the standard Flutter Podfile template: use __FILE__ (path to this
  # Podfile) as the expand base, NOT __dir__. With __dir__ ("ios/"), the `..`
  # resolves to <root>/Flutter/Generated.xcconfig — which doesn't exist. With
  # __FILE__ ("ios/Podfile"), File.expand_path treats the trailing path
  # component as if it were a dir, so .. correctly walks back to ios/, giving
  # <root>/ios/Flutter/Generated.xcconfig. This subtle quirk is why every
  # Flutter Podfile in the wild uses __FILE__.
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # MLKit language packs for multi-script text recognition.
  # Self-detected: if `.flutter-plugins-dependencies` no longer lists the
  # `google_mlkit_*` Flutter wrappers (the sim CI workflow strips them
  # because GoogleMLKit ships no arm64-sim slices and we need arm64 sim
  # for iOS 26 / Liquid Glass), skip the language packs too — they have
  # no consumer without the wrapper plugins.
  # Version must match GoogleMLKit/TextRecognition ~> 9.0.0 required by
  # google_mlkit_text_recognition 0.15.1 — do NOT change to a different major.
  plugins_dep_file = File.expand_path('../.flutter-plugins-dependencies', __dir__)
  has_mlkit_plugins = File.exist?(plugins_dep_file) &&
    File.read(plugins_dep_file).include?('google_mlkit')
  if has_mlkit_plugins
    pod 'GoogleMLKit/TextRecognitionChinese', '~> 9.0.0'
    pod 'GoogleMLKit/TextRecognitionDevanagari', '~> 9.0.0'
    pod 'GoogleMLKit/TextRecognitionJapanese', '~> 9.0.0'
    pod 'GoogleMLKit/TextRecognitionKorean', '~> 9.0.0'
  else
    puts "[Podfile] MLKit plugins not in .flutter-plugins-dependencies → skipping language packs"
  end

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# The RewordiumKeyboard app extension target is intentionally NOT listed here.
# Flutter plugins are not extension-safe (Firebase / file_picker / etc. expect
# the host UIApplication). The extension links KeyboardKit via SwiftPM only.

post_install do |installer|
  # Exclude armv7 on all build configs; bump every pod to our minimum
  # iOS deployment target.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=*]'] = 'armv7'
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if Gem::Version.new($iOSVersion) > Gem::Version.new(config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || '0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
      end
    end
  end

  # NOTE: We used to ship a 3-layer post_install patch here to wrap MLKit
  # registrations in #if !TARGET_OS_SIMULATOR, strip MLKit -framework refs
  # from Pods-Runner xcconfig, and guard the framework-embed script. That
  # approach was too fragile (xcconfig keys can land in unexpected files,
  # framework refs come from multiple places). The current strategy is to
  # prevent MLKit pods from being installed in the simulator workflow at
  # all — codemagic.yaml strips `google_mlkit_*` from
  # `.flutter-plugins-dependencies` BEFORE `flutter build ios --no-pub`,
  # so `flutter_install_all_ios_pods` never sees them and the language
  # packs above self-skip via the `has_mlkit_plugins` check. Device
  # builds keep MLKit normally.
end
